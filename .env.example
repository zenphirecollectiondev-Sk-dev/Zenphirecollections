# ==============================================================================
# ZENPHIRE COLLECTIONS — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure these variables in your Vercel Project Settings (Settings -> Environment Variables).
# IMPORTANT: Never commit actual keys, tokens, or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Supabase Project URL (Found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anonymous API Key (Safe for browser / client-side)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Secret Key (CRITICAL: Serverless functions only, NEVER expose to browser)
# Found in Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY (TEST / LIVE)
# ------------------------------------------------------------------------------
# For Test Mode: use rzp_test_... keys
# For Live Mode: use rzp_live_... keys
# Found in Razorpay Dashboard -> Settings -> API Keys

# Public Key ID for client-side checkout modal
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# Public Key ID for serverless order creation
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# Razorpay Key Secret (CRITICAL: Serverless functions only, NEVER expose to browser)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ------------------------------------------------------------------------------
# RAZORPAY WEBHOOKS
# ------------------------------------------------------------------------------
# Set this secret in Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
# Webhook URL: https://yourdomain.com/api/razorpay-webhook
# Active Events: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_passphrase_here
